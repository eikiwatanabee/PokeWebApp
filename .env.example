# === Database ===
# Option 1: Supabase / full connection string
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Option 2: Individual params (for local dev / docker-compose)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pokebookmanager
DB_PORT=5432
DB_SSLMODE=disable

# === Auth ===
# Google OAuth2 (optional, for Google SSO)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

# GitHub OAuth2 (recommended, for GitHub SSO)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/api/auth/github/callback

# GitHub Webhook Secret (for verifying webhook payloads)
GITHUB_WEBHOOK_SECRET=your-webhook-secret

# JWT Secret (change in production)
JWT_SECRET=your-jwt-secret-change-me

# === Frontend (set in Vercel dashboard) ===
# NEXT_PUBLIC_API_URL=https://pokegithub-api.onrender.com
